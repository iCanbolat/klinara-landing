// Cloudflare Workers (statik varlıklar). Cloudflare Pages kullanıyorsanız bu dosya
// gerekmez: build komutu `pnpm build`, çıktı dizini `build/client` (README).
{
  "name": "klinara-landing",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
