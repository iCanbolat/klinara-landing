{
  "name": "klinara-promo-video",
  "version": "1.0.0",
  "description": "Klinara landing hero promo videosu (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "lucide-react": "^1.62.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "npm run audio && remotion studio --port 3100",
    "audio": "node scripts/generate-audio.mjs",
    "stills": "node scripts/stills.mjs",
    "render:mp4": "remotion render KlinaraPromo out/klinara-promo.mp4 --codec h264 --crf 23",
    "render:mp4-720": "remotion ffmpeg -v error -y -i out/klinara-promo.mp4 -vf scale=720:900 -c:v libx264 -crf 25 -preset slow -pix_fmt yuv420p -movflags +faststart -c:a copy out/klinara-promo-720.mp4",
    "poster": "remotion still KlinaraPromo out/klinara-promo-poster.jpg --frame 381 --image-format jpeg --jpeg-quality 85",
    "render": "npm run audio && npm run render:mp4 && npm run render:mp4-720 && npm run poster",
    "build": "remotion bundle",
    "lint": "eslint src && tsc",
    "publish:landing": "node scripts/publish.mjs",
    "carousel": "npm run audio && node scripts/carousel.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
